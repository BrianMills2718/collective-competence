<?xml version="1.0" encoding="UTF-8"?>
<experiments>
  <experiment name="p14-discovery" repetitions="12" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="200">
    <setup>random-seed (31000 + behaviorspace-run-number)
setup</setup>
    <go>go</go>
    <metrics>
      <metric>ticks</metric>
      <metric>mean [dx] of turtles with [who mod 4 = 0]</metric>
      <metric>mean [dy] of turtles with [who mod 4 = 0]</metric>
      <metric>mean [dx] of turtles with [who mod 4 != 0]</metric>
      <metric>mean [dy] of turtles with [who mod 4 != 0]</metric>
      <metric>mean [dx] of turtles</metric>
      <metric>mean [dy] of turtles</metric>
      <metric>mean [count flockmates] of turtles</metric>
      <metric>ifelse-value any? turtles with [any? flockmates] [mean [abs (subtract-headings heading average-flockmate-heading)] of turtles with [any? flockmates]] [0]</metric>
      <metric>count turtles</metric>
      <metric>vision</metric>
    </metrics>
    <constants>
      <enumeratedValueSet variable="population"><value value="100"></value></enumeratedValueSet>
      <enumeratedValueSet variable="vision"><value value="5"></value></enumeratedValueSet>
      <enumeratedValueSet variable="minimum-separation"><value value="1"></value></enumeratedValueSet>
      <enumeratedValueSet variable="max-align-turn"><value value="5"></value></enumeratedValueSet>
      <enumeratedValueSet variable="max-cohere-turn"><value value="3"></value></enumeratedValueSet>
      <enumeratedValueSet variable="max-separate-turn"><value value="1.5"></value></enumeratedValueSet>
    </constants>
  </experiment>

  <experiment name="p14-sham" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="350">
    <setup>random-seed (32000 + behaviorspace-run-number)
setup</setup>
    <go>go</go>
    <metrics>
      <metric>ticks</metric><metric>mean [dx] of turtles with [who mod 4 = 0]</metric><metric>mean [dy] of turtles with [who mod 4 = 0]</metric><metric>mean [dx] of turtles with [who mod 4 != 0]</metric><metric>mean [dy] of turtles with [who mod 4 != 0]</metric><metric>mean [dx] of turtles</metric><metric>mean [dy] of turtles</metric><metric>mean [count flockmates] of turtles</metric><metric>ifelse-value any? turtles with [any? flockmates] [mean [abs (subtract-headings heading average-flockmate-heading)] of turtles with [any? flockmates]] [0]</metric><metric>count turtles</metric><metric>vision</metric>
    </metrics>
    <constants><enumeratedValueSet variable="population"><value value="100"></value></enumeratedValueSet><enumeratedValueSet variable="vision"><value value="5"></value></enumeratedValueSet><enumeratedValueSet variable="minimum-separation"><value value="1"></value></enumeratedValueSet><enumeratedValueSet variable="max-align-turn"><value value="5"></value></enumeratedValueSet><enumeratedValueSet variable="max-cohere-turn"><value value="3"></value></enumeratedValueSet><enumeratedValueSet variable="max-separate-turn"><value value="1.5"></value></enumeratedValueSet></constants>
  </experiment>

  <experiment name="p14-cohort-rotate" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="350">
    <setup>random-seed (32000 + behaviorspace-run-number)
setup</setup>
    <go>if ticks = 150 [foreach (sort turtles with [who mod 4 = 0]) [t -&gt; ask t [set heading ((heading + 180) mod 360)]]]
go</go>
    <metrics>
      <metric>ticks</metric><metric>mean [dx] of turtles with [who mod 4 = 0]</metric><metric>mean [dy] of turtles with [who mod 4 = 0]</metric><metric>mean [dx] of turtles with [who mod 4 != 0]</metric><metric>mean [dy] of turtles with [who mod 4 != 0]</metric><metric>mean [dx] of turtles</metric><metric>mean [dy] of turtles</metric><metric>mean [count flockmates] of turtles</metric><metric>ifelse-value any? turtles with [any? flockmates] [mean [abs (subtract-headings heading average-flockmate-heading)] of turtles with [any? flockmates]] [0]</metric><metric>count turtles</metric><metric>vision</metric>
    </metrics>
    <constants><enumeratedValueSet variable="population"><value value="100"></value></enumeratedValueSet><enumeratedValueSet variable="vision"><value value="5"></value></enumeratedValueSet><enumeratedValueSet variable="minimum-separation"><value value="1"></value></enumeratedValueSet><enumeratedValueSet variable="max-align-turn"><value value="5"></value></enumeratedValueSet><enumeratedValueSet variable="max-cohere-turn"><value value="3"></value></enumeratedValueSet><enumeratedValueSet variable="max-separate-turn"><value value="1.5"></value></enumeratedValueSet></constants>
  </experiment>

  <experiment name="p14-cohort-rotate-vision-off" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="350">
    <setup>random-seed (32000 + behaviorspace-run-number)
setup</setup>
    <go>if ticks = 150 [foreach (sort turtles with [who mod 4 = 0]) [t -&gt; ask t [set heading ((heading + 180) mod 360)]] set vision 0]
go</go>
    <metrics>
      <metric>ticks</metric><metric>mean [dx] of turtles with [who mod 4 = 0]</metric><metric>mean [dy] of turtles with [who mod 4 = 0]</metric><metric>mean [dx] of turtles with [who mod 4 != 0]</metric><metric>mean [dy] of turtles with [who mod 4 != 0]</metric><metric>mean [dx] of turtles</metric><metric>mean [dy] of turtles</metric><metric>mean [count flockmates] of turtles</metric><metric>ifelse-value any? turtles with [any? flockmates] [mean [abs (subtract-headings heading average-flockmate-heading)] of turtles with [any? flockmates]] [0]</metric><metric>count turtles</metric><metric>vision</metric>
    </metrics>
    <constants><enumeratedValueSet variable="population"><value value="100"></value></enumeratedValueSet><enumeratedValueSet variable="vision"><value value="5"></value></enumeratedValueSet><enumeratedValueSet variable="minimum-separation"><value value="1"></value></enumeratedValueSet><enumeratedValueSet variable="max-align-turn"><value value="5"></value></enumeratedValueSet><enumeratedValueSet variable="max-cohere-turn"><value value="3"></value></enumeratedValueSet><enumeratedValueSet variable="max-separate-turn"><value value="1.5"></value></enumeratedValueSet></constants>
  </experiment>

  <experiment name="p14-whole-rotate" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="350">
    <setup>random-seed (32000 + behaviorspace-run-number)
setup</setup>
    <go>if ticks = 150 [foreach (sort turtles) [t -&gt; ask t [set heading ((heading + 90) mod 360)]]]
