<?xml version="1.0" encoding="UTF-8"?>
<experiments>
  <experiment name="p7-002-screen-baseline" repetitions="8" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="100">
    <setup>random-seed (9100 + behaviorspace-run-number)
setup</setup><go>go</go>
    <metrics><metric>ticks</metric><metric>count turtles with [infected?]</metric><metric>count turtles with [resistant?]</metric></metrics>
    <constants>
      <enumeratedValueSet variable="number-of-nodes"><value value="150"></value></enumeratedValueSet>
      <enumeratedValueSet variable="average-node-degree"><value value="6"></value></enumeratedValueSet>
      <enumeratedValueSet variable="initial-outbreak-size"><value value="3"></value></enumeratedValueSet>
      <enumeratedValueSet variable="virus-spread-chance"><value value="1.5"></value><value value="2"></value></enumeratedValueSet>
      <enumeratedValueSet variable="virus-check-frequency"><value value="1"></value></enumeratedValueSet>
      <enumeratedValueSet variable="recovery-chance"><value value="5"></value><value value="8"></value></enumeratedValueSet>
      <enumeratedValueSet variable="gain-resistance-chance"><value value="5"></value></enumeratedValueSet>
    </constants>
  </experiment>
