<?xml version='1.0' encoding='utf-8'?>
<experiments>
  <experiment name="p2v2-train-discovery-feedback" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="160">
    <setup>setup-aligned-ambient</setup>
    <go>go-displacement</go>
    <metrics>
      <metric>ticks</metric>
      <metric>temperature</metric>
    </metrics>
    <constants>
      <enumeratedValueSet variable="arm">
        <value value="&quot;feedback&quot;" />
      </enumeratedValueSet>
      <enumeratedValueSet variable="setpoint">
        <value value="12.5" />
        <value value="17.5" />
        <value value="22.5" />
        <value value="28.5" />
      </enumeratedValueSet>
      <enumeratedValueSet variable="displacement-amount">
        <value value="-5.5" />
        <value value="6.5" />
      </enumeratedValueSet>
      <enumeratedValueSet variable="initial-temperature">
        <value value="20" />
      </enumeratedValueSet>
      <enumeratedValueSet variable="ambient-temperature">
        <value value="20" />
      </enumeratedValueSet>
      <enumeratedValueSet variable="relaxation-rate">
        <value value="0.05" />
      </enumeratedValueSet>
      <enumeratedValueSet variable="controller-gain">
        <value value="0.25" />
      </enumeratedValueSet>
      <enumeratedValueSet variable="max-control">
        <value value="2" />
      </enumeratedValueSet>
      <enumeratedValueSet variable="max-ticks">
        <value value="160" />
      </enumeratedValueSet>
      <enumeratedValueSet variable="load-magnitude">
        <value value="0" />
      </enumeratedValueSet>
    </constants>
  </experiment>
