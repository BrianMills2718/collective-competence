<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[__includes ["adaptation.nls"]]]></code>
  <widgets>
    <view x="10" y="10" width="20" height="20" minPxcor="-10" maxPxcor="9" minPycor="-10" maxPycor="9" patchSize="8" wrappingAllowedX="true" wrappingAllowedY="true" frameRate="30" updateMode="1" showTickCounter="true" tickCounterLabel="ticks" fontSize="11"></view>
    <button x="190" y="10" width="90" height="40" display="Setup" kind="Observer" forever="false" disableUntilTicks="false">setup</button>
    <button x="285" y="10" width="90" height="40" display="Go" kind="Observer" forever="true" disableUntilTicks="true">go</button>
    <plot x="190" y="60" width="620" height="250" display="Learning across episodes" xAxis="tick" yAxis="temperature" xMin="0" xMax="250" yMin="10" yMax="30" autoPlotX="true" autoPlotY="true" legend="true"><setup>clear-plot</setup><update></update><pen display="temperature" interval="1" mode="0" color="-955883" legend="true"><setup></setup><update>plot temperature</update></pen><pen display="target" interval="1" mode="0" color="-10899396" legend="true"><setup></setup><update>plot setpoint</update></pen></plot>
    <plot x="190" y="320" width="620" height="250" display="Policy parameter" xAxis="tick" yAxis="gain" xMin="0" xMax="250" yMin="0" yMax="0.8" autoPlotX="true" autoPlotY="false" legend="true"><setup>clear-plot</setup><update></update><pen display="controller gain" interval="1" mode="0" color="-13345367" legend="true"><setup></setup><update>plot controller-gain</update></pen></plot>
  </widgets>
  <info><![CDATA[# Experiment 005

Five repeated disturbance episodes reveal whether earlier error changes later behavior. The adaptive controller raises its gain after each episode; frozen and reset-between controls expose whether improvement actually depends on retained history.]]></info>
  <turtleShapes><shape name="default" rotatable="true" editableColorIndex="0"><polygon color="-1920102913" filled="true" marked="true"><point x="150" y="5"></point><point x="40" y="250"></point><point x="150" y="205"></point><point x="260" y="250"></point></polygon></shape></turtleShapes>
  <linkShapes><shape name="default" curviness="0"><lines><line x="0" visible="true"><dash value="1"></dash><dash value="0"></dash></line></lines><indicator><shape name="link direction" rotatable="true" editableColorIndex="0"><line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line><line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line></shape></indicator></shape></linkShapes>
  <previewCommands>set arm "adaptive"
set actuator-effectiveness 0.63
set load-magnitude 0.28
set initial-temperature 20
set setpoint 20
set ambient-temperature 20
set relaxation-rate 0.05
set initial-gain 0.05
set learning-rate 0.08
set max-gain 0.8
set max-control 2
set episode-length 50
set episode-count 5
set max-ticks 250
setup
repeat 250 [ go ]</previewCommands>
  <experiments></experiments>
</model>
