extensions [csv]

globals [
  arm allocation initial-temperature ambient-temperature setpoint
  relaxation-rate controller-gain max-control load-magnitude max-ticks
  temperature control-error passive-term desired-total route-a-command route-b-command
  route-a-applied route-b-applied external-load route-a-disabled?
  route-b-disabled? load-active? trajectory-log last-event
]

to setup
  ; Configuration is supplied by BehaviorSpace globals rather than widgets, so
  ; clear state without zeroing those configured values.
  clear-turtles
  clear-patches
  clear-all-plots
  set temperature initial-temperature
  set load-active? false
  set route-a-disabled? false
  set route-b-disabled? false
  set trajectory-log (list trajectory-header)
  set last-event "setup"
  refresh-derived
  reset-ticks
  record-trajectory last-event
end

to go
  if ticks >= max-ticks [ stop ]
  if ticks = 20 [ activate-case ]
  refresh-derived
  set temperature temperature + passive-term + route-a-applied + route-b-applied + external-load
  tick
  record-trajectory "step"
end

to activate-case
  set load-active? true
  if arm = "route-a-disabled" [ set route-a-disabled? true ]
  if arm = "route-b-disabled" [ set route-b-disabled? true ]
  if arm = "dual-disabled" [
    set route-a-disabled? true
    set route-b-disabled? true
  ]
  set last-event "load-and-fault"
end

to refresh-derived
  set control-error temperature - setpoint
  set passive-term relaxation-rate * (ambient-temperature - temperature)
  ifelse load-active? [ set external-load load-magnitude ] [ set external-load 0 ]
  ifelse arm = "passive" [
    set desired-total 0
    set route-a-command 0
    set route-b-command 0
  ] [
    set desired-total bounded-control (- controller-gain * control-error)
    ifelse allocation = "reroute" [ allocate-to-available ] [
      set route-a-command desired-total / 2
      set route-b-command desired-total / 2
    ]
  ]
  ifelse route-a-disabled? [ set route-a-applied 0 ] [ set route-a-applied route-a-command ]
  ifelse route-b-disabled? [ set route-b-applied 0 ] [ set route-b-applied route-b-command ]
end

to allocate-to-available
  let available-count 2
  if route-a-disabled? [ set available-count available-count - 1 ]
  if route-b-disabled? [ set available-count available-count - 1 ]
  ifelse available-count = 0 [
    set route-a-command 0
    set route-b-command 0
  ] [
    ifelse route-a-disabled?
      [ set route-a-command 0 ]
      [ set route-a-command desired-total / available-count ]
    ifelse route-b-disabled?
      [ set route-b-command 0 ]
      [ set route-b-command desired-total / available-count ]
  ]
end

to-report bounded-control [requested]
  report max (list (- max-control) (min (list max-control requested)))
end

to-report distance-to-setpoint
  report abs (temperature - setpoint)
end

to-report trajectory-header
  report (list "tick" "event" "arm" "allocation" "temperature" "setpoint"
    "error" "passive_term" "desired_total" "route_a_command"
    "route_b_command" "route_a_applied" "route_b_applied" "external_load"
    "route_a_disabled" "route_b_disabled" "distance_to_setpoint")
end

to-report trajectory-row [event-name]
  report (list ticks event-name arm allocation temperature setpoint control-error passive-term
    desired-total route-a-command route-b-command route-a-applied route-b-applied
    external-load route-a-disabled? route-b-disabled? distance-to-setpoint)
end

to record-trajectory [event-name]
  set trajectory-log lput (trajectory-row event-name) trajectory-log
end

to export-trajectory [path]
  csv:to-file path trajectory-log
end
