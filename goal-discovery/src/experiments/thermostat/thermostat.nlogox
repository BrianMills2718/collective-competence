  <previewCommands>set arm "feedback"
set initial-temperature 20
set ambient-temperature 20
set setpoint 20
set relaxation-rate 0.05
set controller-gain 0.25
set max-control 2
set displacement-amount 15
set load-magnitude -1.5
set max-ticks 160
setup
displace-state
repeat 20 [ step-once ]</previewCommands>
