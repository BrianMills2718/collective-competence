.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Runs are regenerable from their seed in seconds, so they are not committed --
# except the two day-one runs, kept so a reader can inspect the evidence
# without running anything.
results/*
!results/.gitkeep
!results/dayone-baseline/
!results/dayone-branch/
!results/001-validation-v2/
!results/001-validation-v2-fixed/
!results/001-validation-v2-c34/
!results/001-confirmation/
!results/002-bowl/
