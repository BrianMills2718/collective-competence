{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scientific-hypergraph:fixture-v1",
  "title": "Scientific Hypergraph Fixture v1",
  "description": "Normalized typed n-ary hypergraph fixture. Binding ids are optional; when present they identify first-class addressable RoleBinding model elements and share the semantic identity namespace with nodes and hyperedges. Cross-category uniqueness/reference validity is enforced by the semantic validator.",
  "type": "object",
  "required": ["model", "imports", "nodes", "hyperedges"],
  "properties": {
    "model": {"const": "scientific-hypergraph-v1"},
    "imports": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "layer": {"type": "string"},
          "kind": {"type": "string"},
          "type": {"type": ["string", "array"]}
        },
        "additionalProperties": true
      }
    },
    "hyperedges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "bindings"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "layer": {"type": "string"},
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "participant"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Optional global semantic ID for this RoleBinding. If supplied, another relation may use this ID as a participant."
                },
                "role": {"type": "string", "minLength": 1},
                "qualifier": {"type": "string", "minLength": 1},
                "participant": {
                  "type": "string",
                  "minLength": 1,
                  "description": "ID of a node, RelationInstance, or addressable RoleBinding."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true,
        "not": {"required": ["roles"]}
      }
    }
  },
  "additionalProperties": true
}
