{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scientific-hypergraph:fixture-v1",
  "title": "Scientific Hypergraph Fixture v1",
  "type": "object",
  "required": ["model", "imports", "nodes", "hyperedges"],
  "properties": {
    "model": {"const": "scientific-hypergraph-v1"},
    "imports": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "layer": {"type": "string"},
          "kind": {"type": "string"},
          "type": {"type": ["string", "array"]}
        },
        "additionalProperties": true
      }
    },
    "hyperedges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "bindings"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "layer": {"type": "string"},
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "participant"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "role": {"type": "string", "minLength": 1},
                "qualifier": {"type": "string", "minLength": 1},
                "participant": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true,
        "not": {"required": ["roles"]}
      }
    }
  },
  "additionalProperties": true
}
