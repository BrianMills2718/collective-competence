{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collective-competence:scientific-hypergraph-fixture-v0",
  "title": "Scientific Hypergraph Fixture v0",
  "type": "object",
  "required": ["nodes", "hyperedges"],
  "properties": {
    "model": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "hyperedges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hyperedge" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "enum": ["metamodel", "schema", "theory", "study", "evidence"]
    },
    "node": {
      "type": "object",
      "required": ["id", "layer"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "layer": { "$ref": "#/$defs/layer" },
        "kind": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hyperedge": {
      "type": "object",
      "required": ["id", "type", "layer", "roles"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/id" },
        "layer": { "$ref": "#/$defs/layer" },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/id" }
        }
      },
      "additionalProperties": true
    }
  }
}
